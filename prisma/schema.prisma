generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===== ENUMS =====

enum KasbonStatus {
  REQUESTED
  PENDING
  COMPLETED
  REJECTED
}

enum AdminRole {
  VIEWER
  OPERATOR
  ADMIN
  SUPER_ADMIN
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum CampaignFrequency {
  ONE_TIME
  WEEKLY
  MONTHLY
}

// ===== EXISTING MODELS (introspected from DB) =====

model User {
  id               String            @id @default(cuid())
  email            String?           @unique
  password         String?
  name             String?
  emailVerified    DateTime?
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  username         String?           @unique
  manychatId       String?           @unique @map("manychat_id")
  go               Boolean           @default(false)
  mcn              Boolean           @default(false)
  whatsapp         String?
  adminRole        AdminRole?        @map("admin_role")
  aiGeneratedPages AIGeneratedPage[]
  accounts         Account[]
  commission       Commission?
  kasbons          Kasbon[]
  profiles         Profile[]
  RefreshToken     RefreshToken[]
  sessions         Session[]
  adminAuditLogs   AdminAuditLog[]
  campaigns        Campaign[]
}

model Commission {
  id                  String   @id @default(cuid())
  userId              String   @unique
  paidCommission      BigInt?  @map("paid_commission")
  pendingCommission   BigInt?  @map("pending_commission")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  agencyPercentage    Int?     @map("agency_percentage")
  cancelledCommission BigInt?  @map("cancelled_commission")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Kasbon {
  id        String       @id @default(cuid())
  userId    String
  amount    BigInt
  status    KasbonStatus @default(REQUESTED)
  note      String?
  adminNote String?      @map("admin_note")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id                    String   @id @default(cuid())
  username              String   @unique
  displayName           String
  bio                   String?
  avatarUrl             String?
  userId                String?
  backgroundColor       String   @default("#0f172a")
  backgroundType        String   @default("solid")
  backgroundGradient    String?
  backgroundImage       String?
  profileTextColor      String   @default("#f1f5f9")
  profileAccentColor    String   @default("#10b981")
  profileBioColor       String   @default("#94a3b8")
  fontFamily            String   @default("Inter")
  avatarBorderColor     String   @default("#10b981")
  avatarBorderWidth     Int      @default(4)
  linkButtonStyle       String   @default("rounded")
  linkButtonColor       String   @default("#ffffff")
  linkButtonTextColor   String   @default("#0f172a")
  linkButtonBorder      String   @default("none")
  linkButtonBorderColor String   @default("#10b981")
  linkButtonShadow      String   @default("md")
  linkButtonShadowColor String   @default("#000000")
  linkButtonAnimation   String   @default("scale")
  linkButtonBorderWidth Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  links                 Link[]
  user                  User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Link {
  id          String  @id @default(cuid())
  title       String
  url         String
  icon        String  @default("")
  order       Int
  enabled     Boolean @default(true)
  type        String  @default("classic")
  buttonColor String?
  textColor   String?
  borderColor String?
  borderStyle String?
  borderWidth Int?
  buttonStyle String?
  shadow      String?
  shadowColor String?
  animation   String?
  iconColor   String?
  thumbnail   String?
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model AIGeneratedPage {
  id            String   @id @default(cuid())
  userId        String
  prompt        String
  profession    String?
  style         String   @default("modern")
  colorScheme   String   @default("dark")
  generatedHtml String
  generatedCss  String?
  sourceType    String   @default("generated")
  sourceUrl     String?
  slug          String   @unique
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ===== D-01: ADMIN PANEL MODELS =====

model Template {
  id                       String    @id @default(cuid())
  name                     String
  category                 String
  seedanceConfigJson       Json      @map("seedance_config_json")
  fallbackVendorConfigJson Json?     @map("fallback_vendor_config_json")
  sampleThumbnailUrl       String?   @map("sample_thumbnail_url")
  performanceTags          String[]  @map("performance_tags")
  performanceScore         Float?    @map("performance_score")
  isActive                 Boolean   @default(true) @map("is_active")
  archivedAt               DateTime? @map("archived_at")
  createdBy                String    @map("created_by")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([category])
  @@map("templates")
}

model ScriptLibrary {
  id         String   @id @default(cuid())
  text       String
  poiType    String   @map("poi_type")
  language   String
  market     String
  usageCount Int      @default(0) @map("usage_count")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([poiType])
  @@index([language, market])
  @@map("script_library")
}

// ===== D-02: POI & CAMPAIGN MODELS =====

model Poi {
  id         String   @id @default(cuid())
  externalId String?  @unique @map("external_id")
  name       String
  type       String   // ACC, TTD, FNB
  market     String   // IDN, US, SGP
  address    String?
  city       String?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@index([market])
  @@index([isActive])
  @@map("pois")
}

model Campaign {
  id              String            @id @default(cuid())
  name            String
  description     String?
  targetPoiTypes  String[]          @map("target_poi_types")
  requiredPosts   Int               @map("required_posts")
  creditReward    Decimal           @map("credit_reward") @db.Decimal(18, 4)
  currency        String            @default("IDR")
  startDate       DateTime          @map("start_date")
  endDate         DateTime          @map("end_date")
  maxParticipants Int?              @map("max_participants")
  maxTotalCredits Decimal?          @map("max_total_credits") @db.Decimal(18, 4)
  totalCredited   Decimal           @default(0) @map("total_credited") @db.Decimal(18, 4)
  frequency       CampaignFrequency @default(ONE_TIME)
  status          CampaignStatus    @default(DRAFT)
  autoPublish     Boolean           @default(false) @map("auto_publish")
  createdBy       String            @map("created_by")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  creator User @relation(fields: [createdBy], references: [id])

  @@index([status])
  @@index([startDate, endDate])
  @@map("campaigns")
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  operatorId   String   @map("operator_id")
  operatorRole String   @map("operator_role")
  actionType   String   @map("action_type")
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  beforeValue  Json?    @map("before_value")
  afterValue   Json?    @map("after_value")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  operator User @relation(fields: [operatorId], references: [id])

  @@index([operatorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}
