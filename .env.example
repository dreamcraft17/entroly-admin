# ============================================================
# ENTROPI Admin Panel — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ----- Database -----
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/entroly"

# ----- Auth -----
# HS256 secret for admin login JWT (run: openssl rand -base64 32)
ADMIN_JWT_SECRET="change-me-generate-with-openssl-rand-base64-32"

# RS256 public key from SSO service (paste PEM, escape newlines as \n)
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# SSO login URL (used for redirect in future SSO integration)
NEXT_PUBLIC_SSO_URL="https://sso.entro.ly"

# ----- S3 / Storage -----
AWS_ACCESS_KEY_ID="from-terraform-output-video_uploader_access_key_id"
AWS_SECRET_ACCESS_KEY="from-terraform-output-video_uploader_secret_access_key"
AWS_REGION="ap-southeast-1"
S3_BUCKET_NAME="from-terraform-output-s3_bucket_name"

# CDN URL (from terraform output cloudfront_domain_name)
NEXT_PUBLIC_CDN_URL="https://XXXXX.cloudfront.net"

# ----- Redis / BullMQ -----
# From terraform output redis_endpoint
REDIS_URL="redis://HOST:6379"

# ----- Push Notifications (Firebase) -----
FIREBASE_PROJECT_ID="entropi-prod"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@entropi-prod.iam.gserviceaccount.com"
# Paste Firebase private key, escape newlines as \n
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ----- Cron (for auto-publish + budget cap job) -----
# Generate: openssl rand -hex 32
CRON_SECRET="change-me-generate-with-openssl-rand-hex-32"

# ----- App -----
NODE_ENV="production"
